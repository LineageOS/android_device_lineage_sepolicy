binder_call(hal_lineage_slider_default, servicemanager)

allow hal_lineage_slider_default input_device:dir r_dir_perms;
allow hal_lineage_slider_default input_device:chr_file r_file_perms;

get_prop(hal_lineage_slider_default, vendor_slider_prop)
