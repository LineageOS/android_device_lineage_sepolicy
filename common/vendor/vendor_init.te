# FM Radio app properties
set_prop(vendor_init, vendor_fm_radio_app_prop)

# NFC
set_prop(vendor_init, vendor_persist_nfc_prop)

# To write to VM nodes
allow vendor_init proc_dirty:file w_file_perms;

# Camera IDs remapping
set_prop(vendor_init, vendor_camera_remapid_prop)

# Camera skip failed IDs
set_prop(vendor_init, vendor_camera_skip_failed_ids_prop)

# Slider
set_prop(vendor_init, vendor_slider_prop)
